# Maintainer: j4y <j4y_w4lk3r@pobox.com>
#
# bmcctl-bin — AMI MegaRAC CLI for ASRock Rack BMCs.
#
# Binary package: pulls the prebuilt linux-x86_64 tarball that goreleaser
# attaches to every GitHub release. No Go toolchain needed at install
# time. A future `bmcctl` (source) package can build from source for
# arm64-on-Arch or non-glibc users; until then this covers ~99% of
# Arch users.
#
# Release flow:
#   1. `git tag vX.Y.Z && git push origin vX.Y.Z`
#   2. .github/workflows/release.yml runs goreleaser, which uploads
#      bmcctl_X.Y.Z_Linux_x86_64.tar.gz to the release AND auto-pushes the
#      AUR bump (via the goreleaser `aurs:` block + AUR_SSH_PRIVATE_KEY).
#   3. arch/aur-bump.sh exists as a manual fallback in case the goreleaser
#      AUR push ever needs a re-run.

pkgname=bmcctl-bin
_pkgname=bmcctl
pkgver=0.1.0
pkgrel=1
pkgdesc="AMI MegaRAC CLI for ASRock Rack BMCs: Redfish + 1Password"
arch=('x86_64')
url="https://github.com/j4y-w4lk3r/bmcctl"
license=('MIT')
depends=('glibc')
optdepends=(
    'ipmitool: required for `bmcctl fru` and `bmcctl mc` (everything else uses Redfish)'
    '1password-cli: required for credential storage and retrieval (the `op` binary)'
)
provides=("${_pkgname}")
conflicts=("${_pkgname}" "${_pkgname}-git")

# Replaced per release by `arch/aur-bump.sh`.
source=("${_pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/${_pkgname}_${pkgver}_Linux_x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"

    install -Dm755 "${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"

    install -Dm644 LICENSE   "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
