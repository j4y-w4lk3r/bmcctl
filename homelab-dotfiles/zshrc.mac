# Search, docs, and snippets
# Text search → rg; files by name → fd (both respect .gitignore). Ripgrep config: ~/.config/ripgrep/config
export RIPGREP_CONFIG_PATH="${RIPGREP_CONFIG_PATH:-$HOME/.config/ripgrep/config}"
# tldr examples (from Homebrew `tlrc`, still invoked as `tldr`; `tl` is tailscale)
alias td='tldr'
alias cheats='cheat -l'
chs() { cheat -c -s "$1"; }
# Navi: Ctrl+] (Control + closing square bracket). Avoid Ctrl+M (= Enter) and Ctrl+G (Starship toggle).
# Also bind in menuselect so Navi still works while the Tab-completion *menu* is open (grey list of --flags).
if command -v navi >/dev/null 2>&1; then
  eval "$(navi widget zsh)"
  bindkey -M emacs '^]' _navi_widget
  bindkey -M viins '^]' _navi_widget
  bindkey -M vicmd '^]' _navi_widget
  bindkey -M menuselect '^]' _navi_widget
  bindkey -M emacs '^G' toggle_starship_prompt
  bindkey -M viins '^G' toggle_starship_prompt
fi

