# jay — tmux session launcher (moved to ~/.config/zsh/jay.zsh)

# hs — “headscale-style” SSH picker: fzf over `tailscale status` peers, then ssh. Works with Tailscale SaaS or
# Headscale (same `tailscale` CLI; only the login server URL changes). Default SSH user: TS_SSH_USER, else $USER.
#   export TS_SSH_USER=j4y
#   hs                # fzf → ssh TS_SSH_USER@<100.x>
#   hs root           # fzf → ssh root@<100.x>
#   hs -o ForwardAgent=yes   # extra args forwarded to ssh(1)
hs() {
  command -v fzf >/dev/null || { echo >&2 "hs: install fzf (brew install fzf)"; return 1; }
  command -v tailscale >/dev/null || { echo >&2 "hs: tailscale CLI not found"; return 1; }

  local ssh_user="${TS_SSH_USER:-$USER}"
  if [[ -n $1 && $1 != -* ]]; then
    ssh_user=$1
    shift
  fi

  local line ip
  line=$(
    if command -v jq >/dev/null 2>&1; then
      command tailscale status --json 2>/dev/null | jq -r '
        [
          (if .Self then .Self else empty end),
          ((.Peer // {}) | to_entries[] | .value)
        ][]
        | select((.TailscaleIPs // []) | length > 0)
        | [
            (if .Online then 0 else 1 end),
            .TailscaleIPs[0],
            (.HostName // ((.DNSName // "") | sub("\\..*"; "")) | if . == "" then "?" else . end),
            (.OS // "?"),
            (if .Online then "online" else "offline" end)
          ] | @tsv
        ' | LC_ALL=C sort -n -t$'\t' -k1,1 | cut -f2-
    else
      command tailscale status 2>/dev/null | awk '
        $1 ~ /^100\./ && NF >= 4 {
          ip = $1; host = $2; os = $4
          status = $5; for (i = 6; i <= NF; i++) status = status " " $i
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", status)
          print ip "\t" host "\t" os "\t" status
        }'
    fi | fzf --height=45% --reverse \
      --delimiter=$'\t' \
      --with-nth=1,2,3,4 \
      --header=$'Enter=ssh (TS_SSH_USER or first arg)\nCtrl-C=cancel' \
      --preview='printf "IP:\t%s\nHost:\t%s\nOS:\t%s\nState:\t%s\n" {1} {2} {3} {4}'
  ) || return 0
  [[ -n "$line" ]] || return 0

  ip="${line%%$'\t'*}"
  command ssh "$@" "${ssh_user}@${ip}"
}

srall() {
  local entry pane cmd count=0
  for entry in $(tmux list-panes -a -F '#{pane_id}:#{pane_current_command}'); do
    pane="${entry%%:*}"
    cmd="${entry#*:}"
    case "$cmd" in
      zsh|bash|sh|fish)
        tmux send-keys -t "$pane" 'sr' Enter
        ((count++))
        ;;
    esac
  done
  echo "reloaded $count shell pane(s)"
}
# ggc / ggs / gga — GitHub helpers (moved to ~/.config/zsh/github.zsh)
# (gcl was renamed to ggc on 2026-05-20)
ff() {
  local out key file
  out=$(fzf --expect=ctrl-o \
            --preview 'bat --color=always {} 2>/dev/null || cat {}' \
            --bind 'ctrl-y:execute-silent(echo -n "$PWD/{}" | pbcopy)+abort' \
            --header 'enter=cursor | ctrl-o=nvim | ctrl-y=copy path')
  key=$(head -1 <<< "$out")
  file=$(sed -n '2p' <<< "$out")
  [ -z "$file" ] && return
  if [ "$key" = "ctrl-o" ]; then
    nvim "$file"
  else
    cursor "$file"
  fi
}

