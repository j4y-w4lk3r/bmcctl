# Universal archive extractor
extract() {
  [ ! -f "$1" ] && { echo "'$1' is not a file"; return 1; }
  case "$1" in
    *.tar.bz2) tar xjf "$1" ;;
    *.tar.gz)  tar xzf "$1" ;;
    *.tar.xz)  tar xJf "$1" ;;
    *.bz2)     bunzip2 "$1" ;;
    *.gz)      gunzip "$1" ;;
    *.tar)     tar xf "$1" ;;
    *.tbz2)    tar xjf "$1" ;;
    *.tgz)     tar xzf "$1" ;;
    *.zip)     unzip "$1" ;;
    *.7z)      7z x "$1" ;;
    *.rar)     unrar x "$1" ;;
    *)         echo "'$1': unknown format" ;;
  esac
}
# brs — moved to ~/.config/zsh/brew.zsh

# direnv
eval "$(direnv hook zsh)"

# zsh-you-should-use
source /opt/homebrew/share/zsh-you-should-use/you-should-use.plugin.zsh

# Cheatsheet — dynamically reads zshrc and shows all aliases, functions & options
zhelp() {
  local rc=~/.zshrc
  {
    echo "# Zshrc Cheatsheet"
    echo ""
    echo "## Aliases"
    grep -E "^alias " "$rc" | grep -v "^#" | sed 's/^alias //' | while IFS='=' read -r name val; do
      val="${val#\"}"; val="${val%\"}"
      val="${val#\'}"  ; val="${val%\'}"
      printf "  %-14s  %s\n" "$name" "$val"
    done
    echo ""
    echo "## Functions"
    grep -E '^[a-zA-Z_][a-zA-Z0-9_-]*\(\)' "$rc" | grep -v '^#' | while read -r line; do
      fname="${line%%\(*}"
      # grab the comment on the line above the function
      desc=$(grep -B1 "^${fname}()" "$rc" | head -1 | grep '^#' | sed 's/^# *//')
      printf "  %-14s  %s\n" "$fname" "${desc:-—}"
    done
    echo ""
    echo "## Zsh Options (setopt)"
    grep -E '^setopt ' "$rc" | grep -v '^#' | while read -r _ opt; do
      printf "  %s\n" "$opt"
    done
    echo ""
    echo "## Keybindings (fzf / tools)"
    echo "  Ctrl-t    Paste file path into command"
    echo "  Ctrl-r    Fuzzy search command history"
    echo "  Alt-c     cd into a directory"
    echo "  Ctrl-y    Copy path (in ff)"
    echo "  Ctrl-o    Open in nvim (in ff)"
    echo "  Ctrl-g    Starship detailed ↔ zen"
    echo "  Ctrl-]    Navi snippet picker (also when Tab menu is open)"
    echo "## Quick commands"
    echo "  td <cmd>   tldr examples (same as tldr)"
    echo "  cheats     list cheat sheets | chs <term>  search in sheets"
    echo "  man rg     colored man pages (MANPAGER + bat)"
    echo "  rg / fd    search text / files by name"
    echo "  cmd | xc     copy stdout to clipboard; xp → pbpaste (xp | …)"
    echo "  take DIR     mkdir + cd (same as mkcd)"
    echo "  hs [user]    fzf Tailscale/Headscale peers → ssh (TS_SSH_USER, optional jq for JSON)"
    echo "  zmv          batch rename (see comment near compinit)"
    echo "  Ctrl+Z  edit current line in nvim (^Z was suspend; see zshrc comment)"
    echo "  atuin_profile default | nas-<stack>   switch Atuin DB + server (exec zsh)"
    echo "  atuin_which    show active profile + atuin paths"
    echo "  atu1n          fzf picker;  atu1n -c --stack … --port …  create profile + Vault + op"
  } | bat --language=md --style=plain --paging=always
}

# Atuin — encrypted/syncable history (run once: `atuin import auto`)
# Profiles: any dir ~/.config/atuin/profiles/nas-*/ with config.toml; active file ~/.config/atuin/active-profile
# See ~/.config/atuin/profiles/README.md and scripts/atuin-profile-create.sh
if [[ -f "$HOME/.config/atuin/active-profile" ]]; then
  IFS= read -r _atuin_pf < "$HOME/.config/atuin/active-profile" || _atuin_pf=""
  case "$_atuin_pf" in
    default|main|"") unset ATUIN_CONFIG_DIR ;;
    nas-personal) export ATUIN_CONFIG_DIR="$HOME/.config/atuin/profiles/nas-j4y" ;; # legacy (before nas-*)
    nas-work) export ATUIN_CONFIG_DIR="$HOME/.config/atuin/profiles/nas-k4i" ;;
    nas-*)
      if [[ -d "$HOME/.config/atuin/profiles/$_atuin_pf" && -f "$HOME/.config/atuin/profiles/$_atuin_pf/config.toml" ]]; then
        export ATUIN_CONFIG_DIR="$HOME/.config/atuin/profiles/$_atuin_pf"
      else
        unset ATUIN_CONFIG_DIR
      fi
      ;;
    *) unset ATUIN_CONFIG_DIR ;;
  esac
  unset _atuin_pf
fi
atuin_profile() {
  emulate -L zsh
  local t="${1:-}"
  case "$t" in
    default|main)
      print -r default >"$HOME/.config/atuin/active-profile"
      ;;
    "")
      print -u2 "usage: atuin_profile default | nas-<stack>  (see ~/.config/atuin/profiles/nas-*/)" >&2
      return 2
      ;;
    nas-personal) print -r nas-j4y >"$HOME/.config/atuin/active-profile" ;;
    nas-work) print -r nas-k4i >"$HOME/.config/atuin/active-profile" ;;
    nas-*)
      if [[ ! -d "$HOME/.config/atuin/profiles/$t" ]]; then
        print -u2 "atuin_profile: missing $HOME/.config/atuin/profiles/$t (use atu1n -c to create)" >&2
        return 2
      fi
      print -r "$t" >"$HOME/.config/atuin/active-profile"
      ;;
    *)
      print -u2 "atuin_profile: unknown '$t' (use default or nas-* with existing profile dir)" >&2
      return 2
      ;;
  esac
  print -r "Atuin profile → $(<$HOME/.config/atuin/active-profile). Restarting shell…"
  exec zsh
}
atuin_which() {
  emulate -L zsh
  local ap="default"
  [[ -f "$HOME/.config/atuin/active-profile" ]] && IFS= read -r ap <"$HOME/.config/atuin/active-profile"
  print -r "active-profile (file):  ${ap}"
  print -r "ATUIN_CONFIG_DIR:         ${ATUIN_CONFIG_DIR:-<unset → default ~/.config/atuin>}"
  local cf="${ATUIN_CONFIG_DIR:-$HOME/.config/atuin}/config.toml"
  if [[ -f "$cf" ]]; then
    print -r "config file:              $cf"
    command rg '^sync_address' "$cf" 2>/dev/null || grep '^sync_address' "$cf"
  fi
  command -v atuin >/dev/null && command atuin info 2>/dev/null | command rg -e 'client config:|client db path:|key path:|session_path|meta db|ATUIN_CONFIG' || command atuin info 2>/dev/null | command head -14
}
atu1n() {
  emulate -L zsh
  if [[ "${1:-}" == (-c|--create) ]]; then
    shift
    command "$HOME/.config/atuin/scripts/atuin-profile-create.sh" "$@"
    return
  fi
  command -v fzf >/dev/null || { print -u2 "atu1n: install fzf (brew install fzf)"; return 1; }
  local -a profs
  local d
  profs=(default)
  for d in "$HOME"/.config/atuin/profiles/nas-*(N/); do
    [[ -f "$d/config.toml" ]] && profs+=("${d:t}")
  done
  local choice
  choice=$(printf '%s\n' "${profs[@]}" | fzf --height=40% --reverse --prompt='atuin profile> ' --header=$'Enter=switch (restarts shell)\nCtrl-C=cancel')
  [[ -n "$choice" ]] || return 0
  atuin_profile "$choice"
}
if command -v atuin >/dev/null; then
  eval "$(atuin init zsh)"
  # Prefer Atuin search on Ctrl+U (Ctrl+A is start-of-line; keep it).
  bindkey -M emacs '^U' atuin-search
  bindkey -M viins '^U' atuin-search-viins

  # Keep Ctrl+R for non-Atuin history search (fzf if available).
  if [[ -n "${widgets[fzf-history-widget]}" ]]; then
    bindkey -M emacs '^R' fzf-history-widget
    bindkey -M viins '^R' fzf-history-widget
  else
    bindkey -M emacs '^R' history-incremental-search-backward
    bindkey -M viins '^R' history-incremental-search-backward
  fi
fi

# Vault CLI (NAS over Tailscale). Placed at end so anything above can override if needed.
export VAULT_ADDR=http://100.92.253.124:8200
#--------------------------------------------------------------------------------------------------------------------

# git/gh account switcher (gswitch / gwhoami / gsw)
[ -f "$HOME/.config/zsh/git-account.zsh" ] && source "$HOME/.config/zsh/git-account.zsh"

# YubiKey manager (yk)
#[ -f ~/.config/zsh/yubikey.zsh ] && source ~/.config/zsh/yubikey.zsh

# jay — tmux session launcher (jay)
[ -f ~/.config/zsh/jay.zsh ] && source ~/.config/zsh/jay.zsh

# GitHub helpers (ggc / ggs / gga)
[ -f ~/.config/zsh/github.zsh ] && source ~/.config/zsh/github.zsh

# Image converter (ic)
[ -f ~/.config/zsh/imgconv.zsh ] && source ~/.config/zsh/imgconv.zsh

# Backblaze B2 backup helpers (bb push/pull/ls/size/check/sync/open)
[ -f ~/.config/zsh/backblaze.zsh ] && source ~/.config/zsh/backblaze.zsh

# Brew sync (brs)
[ -f ~/.config/zsh/brew.zsh ] && source ~/.config/zsh/brew.zsh
