# Completion UI (needs compinit before zsh-autocomplete below)
zstyle ':completion:*' menu select
# zstyle ':autocomplete:*' sort-tries yes  # optional: rank zsh-autocomplete tries by use
autoload -Uz compinit && compinit
# zmv — batch rename with glob patterns, e.g.: zmv '(*).txt' '$1.bak'
autoload -Uz zmv

# zsh-bd — jump to a named parent dir or N levels up (bd Projects | bd 2)
[[ -r "$HOME/.zsh/vendor/zsh-bd/bd.zsh" ]] && . "$HOME/.zsh/vendor/zsh-bd/bd.zsh"

# History
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY
setopt AUTO_CD
setopt CORRECT
setopt EXTENDED_GLOB
setopt NO_BEEP

# Source zsh-autosuggestions
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# Source zsh-vi-mode
source /opt/homebrew/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh
# edit-command-line: ZLE copies the buffer to a temp file, runs $EDITOR, reloads the line on save+quit.
# Use nvim here only — EDITOR may be Cursor; Cursor often fails on /private/tmp/zsh….zsh “path does not exist”.
#
# Ctrl+Z → edit-command-line in nvim. This overrides zsh’s default ^Z (suspend-zsh / SIGTSTP); use fg/bg for
# jobs you started from the shell. Raw terminals send ^Z (ASCII 26); Kitty-style CSI-u often sends \e[122;5u
# (122 = “z”, modifier 5 = Ctrl). zsh-vi-mode maps ^X^e and Option+e to edit-command-line too — we clear those
# so only Ctrl+Z opens the editor (they become undefined-key / no-op).
autoload -Uz edit-command-line
zle -N orig-edit-command-line edit-command-line
_edit_command_line_nvim() {
  EDITOR=nvim VISUAL=nvim zle orig-edit-command-line
}
zle -N edit-command-line _edit_command_line_nvim
for _kmap in emacs viins vicmd; do
  bindkey -M "$_kmap" '^Z' edit-command-line           # Ctrl+Z (standard TTY)
  bindkey -M "$_kmap" $'\e[122;5u' edit-command-line  # Ctrl+Z (CSI u — Kitty / some modern terminals)
  bindkey -M "$_kmap" '^X^e' undefined-key            # was edit-command-line (zsh-vi-mode); only ^Z now
  bindkey -M "$_kmap" '^[e' undefined-key            # Option+e / Esc e — same
done
unset _kmap
# Source zsh-autocomplete (must be last)
source /opt/homebrew/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
source "$HOME/.config/fzf/zsh-keybindings.zsh"

# forgit — fzf-powered git helpers (glo, gcb, gbd, ga, …); requires: brew install forgit fzf
for _forgit in \
  /opt/homebrew/share/forgit/forgit.plugin.zsh \
  /opt/homebrew/opt/forgit/share/forgit/forgit.plugin.zsh; do
  [[ -r "$_forgit" ]] && { source "$_forgit"; break; }
done
unset _forgit

# fzf's zsh integration binds Tab to fzf-completion; restore Tab for completion and
# move fzf path completion to Ctrl+X Ctrl+I (emacs / vi insert).
if [[ -n "${widgets[fzf-completion]}" ]]; then
  bindkey -M emacs '^X^I' fzf-completion
  bindkey -M viins '^X^I' fzf-completion
fi
# Tab: accept grey zsh-autosuggestions when present; otherwise normal completion.
# Grey “ghost” text = zsh-autosuggestions (from history), NOT Navi. Tab completion menu = zsh _git / compsys, NOT Navi.
# (Default autosuggest accept keys are still End / → — see ZSH_AUTOSUGGEST_ACCEPT_WIDGETS.)
_tab_autosuggest_or_complete() {
  if (( $#POSTDISPLAY )); then
    zle autosuggest-accept
  else
    zle expand-or-complete
  fi
}
zle -N _tab_autosuggest_or_complete
bindkey -M emacs '^I' _tab_autosuggest_or_complete
bindkey -M viins '^I' _tab_autosuggest_or_complete
# In the completion menu, Tab / Shift+Tab move selection (normal zsh menu behavior).
bindkey -M menuselect '^[[Z' reverse-menu-complete

# Word deletion shortcuts
# Ctrl+W already does backward-kill-word in most keymaps; map Option+Delete too.
# Common sequences for Option+Delete (terminal-dependent): ESC + Backspace / ESC + DEL.
bindkey -M emacs '^[^?' backward-kill-word   # Option+Delete in many terminals
bindkey -M viins '^[^?' backward-kill-word
bindkey -M emacs '^[\b' backward-kill-word   # alternate
bindkey -M viins '^[\b' backward-kill-word
bindkey -M emacs '^[\x7f' backward-kill-word # alternate
bindkey -M viins '^[\x7f' backward-kill-word

source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}
#--------------------------------------------------------------------------------------------------------------------
# Command and output logger
cmdlog() {
  # Create a timestamp-based filename
  local logfile="$HOME/terminal_logs/$(date +%Y%m%d_%H%M%S)_cmdlog.txt"
  # Make sure the directory exists
  mkdir -p "$HOME/terminal_logs"
  # Save the command to the file
  echo "COMMAND: $*" > "$logfile"
  echo "TIMESTAMP: $(date)" >> "$logfile"
  echo "DIRECTORY: $PWD" >> "$logfile"
  echo "OUTPUT:" >> "$logfile"
  echo "----------------------------------------" >> "$logfile"
  # Run the command and capture output
  eval "$@" 2>&1 | tee -a "$logfile"
  echo "----------------------------------------" >> "$logfile"
  echo "Command and output saved to $logfile"
}
# Warp-like command history viewer
cmdhist() {
  local dir="$HOME/terminal_logs"
  mkdir -p "$dir"
  if [ -z "$(ls -A "$dir")" ]; then
    echo "No command logs found in $dir"
    return 1
  fi
  
  # List available logs and let user choose one
  local choice=$(ls -t "$dir" | fzf --preview "cat $dir/{}")
  if [ -n "$choice" ]; then
    less "$dir/$choice"
  fi
}
# Function to capture the last command's output
lastcmd() {
  local tempfile=$(mktemp)
  fc -ln -1 | sed 's/^\s*//' > $tempfile
  echo "COMMAND: $(cat $tempfile)" > ~/last_command.txt
  echo "TIMESTAMP: $(date)" >> ~/last_command.txt
  echo "DIRECTORY: $PWD" >> ~/last_command.txt
  echo "OUTPUT:" >> ~/last_command.txt
  echo "----------------------------------------" >> ~/last_command.txt
  eval "$(cat $tempfile)" 2>&1 | tee -a ~/last_command.txt
  echo "----------------------------------------" >> ~/last_command.txt
  echo "Last command and output saved to ~/last_command.txt"
  rm $tempfile
}

# Silent capture: re-run last command, save output to ~/last_command.txt, print nothing.
lastcmd_silent() {
  local cmd
  cmd="$(fc -ln -1 | sed 's/^\\s*//')"
  [[ -n "$cmd" ]] || return 1

  {
    echo "COMMAND: $cmd"
    echo "TIMESTAMP: $(date)"
    echo "DIRECTORY: $PWD"
    echo "OUTPUT:"
    echo "----------------------------------------"
  } > "$HOME/last_command.txt"

  ( eval "$cmd" ) >> "$HOME/last_command.txt" 2>&1
  echo "----------------------------------------" >> "$HOME/last_command.txt"
}

# Copy the most recently captured log (created by `lastcmd`)
lastcmd_copy() {
  [[ -f "$HOME/last_command.txt" ]] || { echo "No log yet. Run: lastcmd"; return 1; }
  pbcopy < "$HOME/last_command.txt"
  echo "Copied: ~/last_command.txt"
}

# Starship presets live in ~/.config/starship/ (toggle detailed ↔ zen with Ctrl+G).
# If STARSHIP_CONFIG is exported but the file is missing (e.g. legacy
# ~/.config/starship.detailed.toml), Starship ignores it and uses built-in defaults
# (gcloud and other modules reappear). Rewrite known bad paths, then default when empty/missing.
case "${STARSHIP_CONFIG:-}" in
  "$HOME/.config/starship.detailed.toml"|"")
    export STARSHIP_CONFIG="$HOME/.config/starship/starship.detailed.toml" ;;
esac
[[ -f "${STARSHIP_CONFIG:-}" ]] || export STARSHIP_CONFIG="$HOME/.config/starship/starship.detailed.toml"

# Initialize Starship prompt
eval "$(starship init zsh)"

# Print a separator only after a command runs (not on fresh shell start).
# Uses hooks so we don't override other preexec/precmd logic.
autoload -Uz add-zsh-hook
typeset -g __prompt_sep_after_cmd=0
__prompt_sep_mark() {
  # Don't treat ZLE widgets (keybindings) as "commands" for separator purposes.
  [[ -n "${ZLE-}" ]] && return 0
  # Don't treat prompt-rendering invocations as user commands (avoids separator spam).
  case "$1" in
    starship\ prompt*|command\ starship\ prompt*|*'starship prompt'*)
      return 0
      ;;
  esac
  __prompt_sep_after_cmd=1
}
__prompt_sep_draw() {
  # Avoid printing separators during prompt redraws.
  [[ -n "${ZLE-}" ]] && return 0
  if (( __prompt_sep_after_cmd )); then
    local -r cols=${COLUMNS:-80}
    local -r _empty=""
    # Dim gray separator (adjust 240-250 to taste)
    local -r line="${(l:${cols}::─:)_empty}"
    print -P -- "%F{244}${line}%f"
    __prompt_sep_after_cmd=0
  fi
}
# De-duplicate hooks when re-sourcing ~/.zshrc (remove ALL duplicates)
while (( ${preexec_functions[(Ie)__prompt_sep_mark]} )); do
  add-zsh-hook -d preexec __prompt_sep_mark 2>/dev/null || break
done
while (( ${precmd_functions[(Ie)__prompt_sep_draw]} )); do
  add-zsh-hook -d precmd __prompt_sep_draw 2>/dev/null || break
done
add-zsh-hook preexec __prompt_sep_mark
add-zsh-hook precmd  __prompt_sep_draw

# Capture last command string (output capture needs explicit logging)
typeset -g __last_cmd_str=""
__remember_last_cmd() { __last_cmd_str="$1" }
while (( ${preexec_functions[(Ie)__remember_last_cmd]} )); do
  add-zsh-hook -d preexec __remember_last_cmd 2>/dev/null || break
done
add-zsh-hook preexec __remember_last_cmd

# Toggle Starship prompt between detailed and zen modes (Ctrl+G).
# Uses STARSHIP_CONFIG so switching is instant and per-shell-session.
toggle_starship_prompt() {
  local detailed="$HOME/.config/starship/starship.detailed.toml"
  local zen="$HOME/.config/starship/starship.zen.toml"

  if [[ "${STARSHIP_CONFIG:-$detailed}" == "$zen" ]]; then
    export STARSHIP_CONFIG="$detailed"
  else
    export STARSHIP_CONFIG="$zen"
  fi

  zle reset-prompt
}
zle -N toggle_starship_prompt
bindkey -M emacs '^G' toggle_starship_prompt
bindkey -M viins '^G' toggle_starship_prompt

# Copy last captured command+output to clipboard (Ctrl+X then Ctrl+Y / Ctrl+X)
lastcmd_copy_widget() {
  # Keep this widget fully silent: no terminal output, no status message.
  __prompt_sep_after_cmd=0
  # Refresh the capture first, then copy.
  lastcmd_silent 2>/dev/null || true
  [[ -f "$HOME/last_command.txt" ]] && pbcopy < "$HOME/last_command.txt"
  __prompt_sep_after_cmd=0
  return 0
}
zle -N lastcmd_copy_widget
bindkey -M emacs '^X^Y' lastcmd_copy_widget
bindkey -M viins '^X^Y' lastcmd_copy_widget

# Single-keystroke binding (Ctrl+X). Note: in emacs keymap, ^X is traditionally a prefix.
bindkey -M viins '^X' lastcmd_copy_widget

