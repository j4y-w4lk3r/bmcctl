alias m="mullvad"
alias h="htop"
alias b="btop"
alias tm="tmux"
alias tl="tailscale"
alias tls="tailscale status"
alias n="ssh"
alias br="brew"
alias dul="diskutil"
alias v="vim"
alias ser="server"
alias wt='networksetup -getairportpower en0 | grep -q "On" && networksetup -setairportpower en0 off || networksetup -setairportpower en0 on'
alias g="git"
alias gs='git status'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
alias ga='git add'
alias e="exit"
alias f="fastfetch"
alias sp="speedtest"
alias c="clear"
alias xc='pbcopy'   # cmd | xc — copy stdout to clipboard (macOS)
alias xp='pbpaste'  # xp alone prints clipboard; xp | … pipes it
alias take='mkcd'     # mkdir + cd (same as mkcd)
