# eza aliases with icons
alias ls='eza --icons=always'
alias la='eza --icons=always -la'
alias ll='eza --icons=always -lh'
alias lt='eza --icons=always --tree'
# Quick utility functions
mkcd() { mkdir -p "$1" && cd "$1"; }
port() { lsof -i :"$1"; }
killport() { lsof -ti :"$1" | xargs kill -9; }
# Core environment (editor, terminal capabilities, and config path marker)
export CURRENT_ZSHRC="${0:A}"
export TERM=xterm-256color
export EDITOR="cursor"
export VISUAL="cursor"

# Prefer Cursor for opening local paths, keep macOS `open` for URLs/options.
open() {
  emulate -L zsh
  setopt local_options no_shwordsplit

  # No args: open current directory in Cursor.
  if (( $# == 0 )); then
    command cursor .
    return $?
  fi

  local a
  for a in "$@"; do
    # If caller is using macOS open flags, delegate to the system `open`.
    if [[ "$a" == -* ]]; then
      command /usr/bin/open "$@"
      return $?
    fi
    # URLs should use the system `open` (browser/mail handler/etc).
    if [[ "$a" == *"://"* || "$a" == mailto:* ]]; then
      command /usr/bin/open "$@"
      return $?
    fi
  done

  command cursor "$@"
}
# Colored man pages: `man rg`, `man fd`, … (roff → text → bat’s Manpage syntax)
if command -v bat >/dev/null 2>&1; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi
# Lazy-load nvm (faster shell startup)
export NVM_DIR="$HOME/.nvm"
nvm() { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"; nvm "$@"; }
node() { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"; node "$@"; }
npm() { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"; npm "$@"; }
npx() { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"; npx "$@"; }
# Tooling paths (Homebrew, language runtimes, databases)
path_prepend() { [[ -d "$1" ]] && path=("$1" $path); }
path_prepend "/opt/homebrew/bin"
path_prepend "$HOME/.rbenv/bin"
path_prepend "/opt/homebrew/opt/postgresql@15/bin"
# Ruby (rbenv)
eval "$(rbenv init -)"
# Java
export JAVA_HOME="/opt/homebrew/opt/openjdk@11"
path_prepend "$JAVA_HOME/bin"
# App CLIs
alias keka="/Applications/Keka.app/Contents/MacOS/Keka --cli"
