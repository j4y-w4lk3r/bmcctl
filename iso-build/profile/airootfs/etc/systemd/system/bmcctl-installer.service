[Unit]
Description=bmcctl unattended Arch installer
Documentation=https://github.com/j4y-w4lk3r/bmcctl
After=systemd-networkd-wait-online.service network-online.target
Wants=network-online.target
ConditionPathExists=/root/install-config.env
# We do NOT require the network step to succeed — install.sh has
# its own 60s wait + curl probe + clearer error message.

[Service]
Type=oneshot
ExecStart=/root/install.sh
# journal+console means: write the script's stdout/stderr both to
# the systemd journal (so `journalctl -fu bmcctl-installer` after the
# fact shows the full transcript) AND to /dev/console. /dev/console
# in turn routes to every console= in the kernel cmdline -- with our
# bootloader patches that's tty0 (BMC H5Viewer / qemu graphical) AND
# ttyS0 (BMC SOL / qemu -nographic), so an operator on either channel
# watches the install live.
StandardOutput=journal+console
StandardError=journal+console
# Don't restart on failure; install.sh is idempotent enough that
# a fresh manual retry from the live env's serial-getty is the
# right recovery path.
Restart=no
# Long timeout — pacstrap on a slow uplink can take 10+ minutes.
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
